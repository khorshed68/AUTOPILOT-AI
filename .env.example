# Copy with: python scripts/generate_env.py  (creates .env with strong random secrets)

ENVIRONMENT=development
LOG_LEVEL=INFO

# Secrets: never commit real values. Required (32+ characters) in production.
SECRET_KEY=
ENCRYPTION_KEY=

POSTGRES_USER=autopilot
POSTGRES_PASSWORD=
POSTGRES_DB=autopilot

# Host ports for docker compose
POSTGRES_PORT=55440
REDIS_PORT=56390
BACKEND_PORT=8100
FRONTEND_PORT=5190

FRONTEND_URL=http://localhost:5190
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# Must be true behind HTTPS and in production
COOKIE_SECURE=false

# AI provider: mock (no key needed) | anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock
# Leave blank for the provider default (anthropic: claude-opus-5-5)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google OAuth (Gmail, Calendar, Drive): see README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5190/api/integrations/google/callback

# Demo mode. The local demo account exists only while DEMO_USER_PASSWORD is set and ENVIRONMENT is not production.
DEMO_MODE_ENABLED=true
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoPass123!

MAX_UPLOAD_MB=15
